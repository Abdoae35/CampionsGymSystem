{
  "info": {
    "name": "Campeones Excel Bulk Import V1",
    "description": "Optional new Lead/Member/Freelance customer import. Choose a local .xlsx file for preview. Confirmation is explicit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "leads template",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/excel-imports/leads/template"
      }
    },
    {
      "name": "leads preview",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "File",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/api/excel-imports/leads/preview"
      }
    },
    {
      "name": "members template",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/excel-imports/members/template"
      }
    },
    {
      "name": "members preview",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "File",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/api/excel-imports/members/preview"
      }
    },
    {
      "name": "freelance-customers template",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/excel-imports/freelance-customers/template"
      }
    },
    {
      "name": "freelance-customers preview",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "File",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{baseUrl}}/api/excel-imports/freelance-customers/preview"
      }
    },
    {
      "name": "Confirm import",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/excel-imports/{{importId}}/confirm"
      }
    },
    {
      "name": "Read import result",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/excel-imports/{{importId}}"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5236"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "importId",
      "value": ""
    }
  ]
}
