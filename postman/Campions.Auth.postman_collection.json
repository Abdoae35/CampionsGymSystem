                  "const authResponse = pm.response.json();",
                  "pm.test(\"Owner without employee or branch\", () => { pm.expect(authResponse.roles).to.include(\"Owner\"); pm.expect(authResponse.employeeId).to.eql(null); pm.expect(authResponse.currentBranch).to.eql(null); });",
                  "}"
                ]
              }
            }
