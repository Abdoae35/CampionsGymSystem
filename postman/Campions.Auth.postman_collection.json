          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const authResponse = pm.response.json();",
                  " pm.test(\"Access token returned\", () => pm.expect(authResponse.accessToken).to.be.a(\"string\").and.not.empty);",
                  " pm.environment.set(\"ownerToken\", authResponse.accessToken);",
                  "}",
                  "}"
                ]
              }
            }
          ]
