            },
            "description": "Employees.Manage plus target scope. Set branchId and assignmentStartDate. Requires active employee/branch and no overlapping history. Use transfer for a currently assigned employee.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"startDate\": \"{{assignmentStartDate}}\"\n}",
              "options": {
