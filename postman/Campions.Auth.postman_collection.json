          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer employee between branches",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/employees/{{employeeId}}/transfer-branch",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Employees.Transfer and scope on both branches. Cross-branch transfer requires explicit global access under the current conservative policy. Set employeeId, targetBranchId and transferEffectiveDate. Existing business transaction branches remain unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetBranchId\": \"{{targetBranchId}}\",\n  \"effectiveDate\": \"{{transferEffectiveDate}}\"\n}",
              "options": {
