{
  "info": {
    "name": "Campions Auth API",
    "description": "Local auth scenarios only. Import the PRIVATE local environment generated by scripts/setup-local-auth-demo.py. No business endpoints or production credentials. Permissions/403 are covered by automated tests; no debug endpoint is exposed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "invalidToken",
      "value": "invalid-token"
    }
  ],
  "item": [
    {
      "name": "Owner login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userNameOrEmail\": \"{{ownerUserName}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const authResponse = pm.response.json();",
              " pm.test(\"Access token returned\", () => pm.expect(authResponse.accessToken).to.be.a(\"string\").and.not.empty);",
              " pm.environment.set(\"ownerToken\", authResponse.accessToken);",
              "}",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Owner current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const authResponse = pm.response.json();",
              "pm.test(\"Owner without employee or branch\", () => { pm.expect(authResponse.roles).to.include(\"Owner\"); pm.expect(authResponse.employeeId).to.eql(null); pm.expect(authResponse.currentBranch).to.eql(null); });",
              "}"
            ]
          }
        }
      ]
    },
